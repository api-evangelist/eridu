    "_postman_id": "395baf47-882e-4f34-95b8-3e3022fcb5d4",
    "name": "Eridu Taxonomy API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Anonymous read access to the classification vocabularies behind eridu.ai — post categories and post tags — as registered in the WordPress core REST API.\n\nEridu publishes no developer program, no developer portal and no product API. This document is an API Evangelist derivation of the only machine-readable interface the company serves — the WordPress core REST API behind eridu.ai — captured from the provider's own live self-describing route index on 2026-08-12. It is read-only and anonymously readable; write methods exist on the same routes but require a WordPress user with an application password.\n\nContact Support:\n Name: Eridu",
      "type": "text/plain"
    }
  }
