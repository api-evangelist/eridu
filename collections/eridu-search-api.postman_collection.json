    "_postman_id": "10591391-7b64-495b-ae49-1055392e91b7",
    "name": "Eridu Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Anonymous cross-content search over eridu.ai — posts and pages — returning lightweight id / title / url / type / subtype records.\n\nEridu publishes no developer program, no developer portal and no product API. This document is an API Evangelist derivation of the only machine-readable interface the company serves — the WordPress core REST API behind eridu.ai — captured from the provider's own live self-describing route index on 2026-08-12. It is read-only and anonymously readable; write methods exist on the same routes but require a WordPress user with an application password.\n\nContact Support:\n Name: Eridu",
      "type": "text/plain"
    }
  }
